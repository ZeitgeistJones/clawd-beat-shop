# Copy to .env.local for local Generate Lyrics mode.
# Never commit real keys. On Vercel, set these in Project Settings → Environment Variables.

GEMINI_API_KEY=
# Optional backup key. Used automatically if the primary key hits quota/rate limits.
GEMINI_API_KEY_2=
# Optional. Defaults to gemini-3.8-flash (required for new Gemini API keys). Uses thinkingLevel low for speed.
GEMINI_MODEL=
